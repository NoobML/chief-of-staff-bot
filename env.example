# ═══════════════════════════════════════════════════════
#   Chief of Staff Bot — Configuration
#   Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════

# ── AI Provider ──────────────────────────────────────
# Options: groq (free), claude, openai, gemini
AI_PROVIDER=groq

# Add the key for your chosen provider (others can be left blank)
GROQ_API_KEY=your_groq_key_here
ANTHROPIC_API_KEY=your_claude_key_here
OPENAI_API_KEY=your_openai_key_here
GEMINI_API_KEY=your_gemini_key_here

# ── Twilio (WhatsApp) ─────────────────────────────────
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ── Google Sheets ─────────────────────────────────────
GOOGLE_SHEETS_ID=your_sheet_id_here
GOOGLE_CREDENTIALS_FILE=credentials.json

# ── CEO / Admin ───────────────────────────────────────
CEO_WHATSAPP=whatsapp:+1234567890
CEO_PRIVATE_GROUP=whatsapp:+1234567890

# ── WhatsApp Group Map ────────────────────────────────
# Map group numbers to readable names
# Format: whatsapp:+NUMBER=Group Name (comma separated)
GROUP_MAP=whatsapp:+14155238886=Dev Group,whatsapp:+0987654321=Marketing

# ── Bot Behavior ──────────────────────────────────────
FOLLOWUP_DELAY_HOURS=24
MAX_FOLLOWUPS=3
BOT_TONE=professional
BOT_LANGUAGE=english
ALERT_CEO_ON_BLOCKER=true
DAILY_DIGEST_TIME=09:00
FOLLOWUP_TIME=10:00
